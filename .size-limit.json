[
  {
    "name": "Main bundle (gzip)",
    "path": "dist/assets/index-*.js",
    "limit": "500 kB",
    "gzip": true
  },
  {
    "name": "Total JS (gzip)",
    "path": "dist/assets/*.js",
    "limit": "1150 kB",
    "gzip": true
  },
  {
    "name": "Vendor chunks (gzip)",
    "path": "dist/assets/vendor-*.js",
    "limit": "460 kB",
    "gzip": true
  },
  {
    "name": "Wallets vendor (gzip)",
    "path": "dist/assets/vendor-wallets-*.js",
    "limit": "300 kB",
    "gzip": true
  },
  {
    "name": "React vendor (gzip)",
    "path": "dist/assets/react-vendor-*.js",
    "limit": "95 kB",
    "gzip": true
  },
  {
    "name": "Three.js feature (gzip)",
    "path": "dist/assets/feature-three-*.js",
    "limit": "275 kB",
    "gzip": true
  },
  {
    "name": "Stellar feature (gzip)",
    "path": "dist/assets/feature-stellar-*.js",
    "limit": "315 kB",
    "gzip": true
  },
  {
    "name": "CSS bundle",
    "path": "dist/assets/*.css",
    "limit": "40 kB",
    "gzip": true
  },
  {
    "name": "HTML entry",
    "path": "dist/index.html",
    "limit": "6 kB"
  },
  {
    "name": "Total dist size",
    "path": "dist/**/*.{js,css,html}",
    "limit": "1.3 MB"
  }
]
